# Copiá este archivo como ".env" (sin ".example") en la raíz del proyecto.
# El archivo ".env" NO se sube a GitHub: nunca pegues claves reales en este ejemplo.

# --- Modelos locales (Ollama) -------------------------------------------------
# OBLIGATORIO para usar los modelos locales, el evaluador de evidencia (CRAG-lite)
# y la evaluación con Ragas. Ollama no valida la clave: sirve cualquier valor no vacío.
OLLAMA_API_KEY="ollama-local"

# --- Modelos en la nube (OPCIONAL) --------------------------------------------
# Solo hacen falta si vas a elegir ese modelo en la aplicación. Si falta la clave de un
# modelo, ese modelo no funciona (el resto sí). Descomentá solo las que vayas a usar.
# GEMINI_API_KEY="..."     # https://aistudio.google.com/app/apikey (nivel gratuito)
# GROQ_API_KEY="..."       # https://console.groq.com/keys (nivel gratuito)
# MISTRAL_API_KEY="..."
# OPENAI_API_KEY="..."
# DEEPSEEK_API_KEY="..."
# QWEN_API_KEY="..."
# COHERE_API_KEY="..."

# --- Modelo de embeddings (OPCIONAL) ------------------------------------------
# Por defecto se usa BAAI/bge-m3: se descarga de Hugging Face la primera vez, o se
# toma de modelos_locales/bge-m3 si ya existe (ver scripts/descargar_modelo.py).
# Descomentá solo si querés apuntar a otra ruta o modelo:
# EMBEDDING_MODEL_PATH="modelos_locales/bge-m3"
